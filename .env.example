# Copy this file to .env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database (used to build DATABASE_URL for Django) ---
POSTGRES_DB=tt
POSTGRES_USER=tt
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgres://tt:change-me@db:5432/tt

# --- Localization ---
LANGUAGE_CODE=fa

# --- Bale bot (apps.bale) — leave blank to disable messaging features ---
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_API_TIMEOUT=15
