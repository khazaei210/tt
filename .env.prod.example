# Copy this file to .env.prod for a production deployment (docker-compose.prod.yml).
# Never commit .env.prod. Every value below MUST be changed from the example.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Set to False only if there is no TLS-terminating reverse proxy in front
# of this service yet (e.g. reachable by bare IP, no domain/cert). Turns
# off SECURE_SSL_REDIRECT/secure cookies/HSTS so plain HTTP doesn't hit a
# redirect loop. Flip back to True (or omit — True is the default) once a
# domain and TLS proxy (nginx, Caddy, a cloud load balancer) are in place,
# and update DJANGO_ALLOWED_HOSTS / DJANGO_CSRF_TRUSTED_ORIGINS to match.
DJANGO_BEHIND_TLS_PROXY=True

# --- Database (used to build DATABASE_URL for Django) ---
POSTGRES_DB=tt
POSTGRES_USER=tt
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgres://tt:replace-with-a-strong-password@db:5432/tt

# --- Localization ---
LANGUAGE_CODE=fa

# --- gunicorn (docker/web/entrypoint.sh) ---
# Number of worker processes. A common starting point is (2 x CPU cores) + 1.
WEB_CONCURRENCY=3
